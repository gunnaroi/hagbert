---
const { title, siteName, tagline } = Astro.props;
---
<!doctype html>
<html lang="is">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root { --primary: #003a70; --accent: #e8892b; --ink: #1a1a1a; --paper: #ffffff; }
      body { margin: 0; font-family: Inter, system-ui, sans-serif; color: var(--ink); background: var(--paper); }
      header { padding: 1.25rem 2rem; border-bottom: 1px solid #e5e5e5; display: flex; align-items: baseline; gap: 1rem; }
      header a { color: var(--primary); text-decoration: none; font-weight: 700; font-size: 1.25rem; }
      main { max-width: 60rem; margin: 0 auto; padding: 1.5rem 2rem 4rem; }
      .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr)); gap: 1rem; }
      .card { border: 1px solid #e5e5e5; border-radius: 0.5rem; padding: 1rem; color: inherit; text-decoration: none; }
      .card:hover { border-color: var(--primary); }
      .card .v { font-size: 1.5rem; font-weight: 700; }
      .muted { color: #666; font-size: 0.85rem; }
      table { border-collapse: collapse; width: 100%; }
      td, th { border-bottom: 1px solid #eee; padding: 0.35rem 0.5rem; text-align: right; }
      td:first-child, th:first-child { text-align: left; }
    </style>
  </head>
  <body>
    <header>
      <a href={import.meta.env.BASE_URL}>{siteName}</a>
      <span class="muted">{tagline}</span>
    </header>
    <main><slot /></main>
  </body>
</html>
