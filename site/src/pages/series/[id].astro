---
import { readdirSync, readFileSync } from "node:fs";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  const dir = new URL("../../../public/data/series/", import.meta.url);
  return readdirSync(dir)
    .filter((f) => f.endsWith(".json"))
    .map((f) => ({ params: { id: f.replace(/\.json$/, "") } }));
}

const { id } = Astro.params;
const series = JSON.parse(
  readFileSync(new URL(`../../../public/data/series/${id}.json`, import.meta.url), "utf-8")
);
const site = JSON.parse(
  readFileSync(new URL("../../../public/data/site.json", import.meta.url), "utf-8")
);
const rows = series.data.slice(-24);
---
<Layout title={`${series.title} — ${site.site.name}`} siteName={site.site.name} tagline={site.site.tagline}>
  <h1>{series.title}</h1>
  <p class="muted">{series.unit} · {series.frequency}</p>
  <table>
    <thead><tr><th>Period</th><th>Value</th></tr></thead>
    <tbody>
      {rows.map((r) => (<tr><td>{r.period}</td><td>{r.value}</td></tr>))}
    </tbody>
  </table>
</Layout>
